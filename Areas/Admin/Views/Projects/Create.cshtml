@model Projects
<div>
    <h1 class="text-primary">Add Project</h1>
    <form asp-controller="Projects" asp-action="Create" method="post" enctype="multipart/form-data">

        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input asp-for="@Model.Title"  type="text" class="form-control" id="title" placeholder="Enter title...">
            <span class="text-danger" asp-validation-for="@Model.Title"></span>
        </div>
        <div class="mb-3">
            <label for="category" class="form-label">Category</label>
            <input asp-for="@Model.Category" type="text" class="form-control" id="category" placeholder="Enter category...">
            <span class="text-danger" asp-validation-for="@Model.Category"></span>

        </div>
        <div class="mb-3">
            <label for="imageUrl" class="form-label">ImageUrl</label>
            <input asp-for="@Model.ImageFile" type="file" class="form-control" id="imageUrl" placeholder="Enter url...">
            <span class="text-danger" asp-validation-for="@Model.ImageFile"></span>

        </div>
    
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>